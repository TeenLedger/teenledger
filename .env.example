# Database (Supabase). Vercel's Supabase integration sets POSTGRES_URL for you.
# Otherwise: Supabase > Project Settings > Database > Connection string > Transaction pooler (port 6543).
POSTGRES_URL=

# Stripe (Developers > API keys). sk_test_ for testing, sk_live_ for real payments.
STRIPE_SECRET_KEY=
# Optional: Stripe webhook signing secret for /api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Twilio (Console > Account info). Use a number dedicated to TeenLedger.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Or use a Messaging Service instead of a single number
TWILIO_MESSAGING_SERVICE_SID=

# Your own long random values
ADMIN_KEY=
CRON_SECRET=

# Public site address used in links and Twilio signature checks
SITE_URL=https://teenledger.app

# Optional: iCloud link to the shared TeenLedger Shortcut (see /admin for how to make it)
SHORTCUT_URL=
